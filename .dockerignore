# RAGFlow .dockerignore
# Reduces Docker build context sent to the daemon.
# Runtime assets enter through the verified third_partys cache.

# ── Python virtual environments ─────────────────────────────────────────────
.venv/
venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# ── Frontend dependencies and build outputs ─────────────────────────────────
web/node_modules/
web/dist/

# ── Runtime logs ────────────────────────────────────────────────────────────
logs/
**/*.log


# ── Go and C++ build outputs ────────────────────────────────────────────────
internal/binding/cpp/build/
internal/binding/cpp/cmake-build-release/
internal/binding/cpp/cmake-build-debug/
target/

# Go native dependency downloads are independent of the application image.
ragflow_deps/
# Incomplete downloads and extraction receipts are not build inputs.
third_partys/**/*.part
third_partys/.receipts/

# ── IDE and editor config ──────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
.trae/
.DS_Store

# ── Test and coverage artifacts ─────────────────────────────────────────────
coverage/
htmlcov/
.coverage
.hypothesis/
.nox/

# Deployment secrets and generated operational data never enter image contexts.
docker/env/
docker/logs/
docker/state/
docker/home/
docker/backups/
docker/evidence/
docker/ci/.env
docker/ci/ragflow-logs/
docker/ci/oceanbase/conf/
docker/ci/oceanbase/data/
docker/ci/seekdb/
docker/**/*.tar
docker/**/*.tar.gz

ARG BASE_IMAGE=infiniflow/ragflow:v0.27.2
FROM ${BASE_IMAGE}
# Preserve only image-provided runtime assets before /ragflow is bind-mounted.
RUN mkdir -p /opt/ragflow-runtime && \
    cp /ragflow/VERSION /ragflow/9b5ad71b2ce5302211f9c61530b329a4922fc6a4 \
       /ragflow/tika-server-standard-3.3.0.jar \
       /ragflow/tika-server-standard-3.3.0.jar.md5 /opt/ragflow-runtime/
LABEL org.opencontainers.image.description="RAGFlow runtime for a bind-mounted source checkout"

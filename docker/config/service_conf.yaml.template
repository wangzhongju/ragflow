ragflow:
  host: 0.0.0.0
  http_port: 9380
admin:
  host: 0.0.0.0
  http_port: 9381
mysql:
  name: '${MYSQL_DBNAME}'
  user: '${MYSQL_USER}'
  password: '${MYSQL_PASSWORD}'
  host: '${MYSQL_HOST}'
  port: ${MYSQL_PORT}
  max_connections: 100
  stale_timeout: 300
  max_allowed_packet: ${MYSQL_MAX_PACKET}
minio:
  user: '${MINIO_USER}'
  password: '${MINIO_PASSWORD}'
  host: '${MINIO_HOST}:9000'
es:
  hosts: 'http://${ES_HOST}:9200'
  username: elastic
  password: '${ELASTIC_PASSWORD}'
redis:
  db: 1
  password: '${REDIS_PASSWORD}'
  host: '${REDIS_HOST}:6379'
